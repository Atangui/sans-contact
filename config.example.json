{
  "version": 1,
  "camera_name": "Exemple de webcam",
  "camera_backend": "dshow",
  "frame_width": 640,
  "frame_height": 480,
  "frame_rate": 30,
  "num_hands": 1,
  "opencv_threads": 4,
  "hand": "any",
  "pointer_landmark": "palm_center",
  "active_zone": [0.2, 0.15, 0.8, 0.75],
  "one_euro_min_cutoff": 1.0,
  "one_euro_beta": 0.015,
  "one_euro_d_cutoff": 1.0,
  "engagement_hold_s": 1.0,
  "disengage_after_s": 3.0,
  "pause_timeout_s": 30.0,
  "physical_mouse_tolerance_px": 3,
  "pointer_mode": "absolute",
  "relative_gain": 1.0,
  "relative_accel": 0.5,
  "pinch_press": 0.25,
  "pinch_release": 0.38,
  "min_press_ms": 60,
  "drag_start": 0.35,
  "click_rollback_ms": 100,
  "scroll_mode": "smooth",
  "scroll_dead_zone": 0.1,
  "scroll_speed": 12.0,
  "scroll_invert": false,
  "dwell_click": false,
  "dwell_ms": 1000,
  "dwell_radius_px": 12,
  "hotkey": "Ctrl+Alt+Shift+Space",
  "release_on_display_off": true,
  "metrics_log": true
}
